# Google AI Studio key (https://aistudio.google.com/apikey). Server-side only — never prefix with NEXT_PUBLIC_.
# Without it the app still works: plans fall back to the deterministic rule engine.
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional: override the Gemini model id.
GEMINI_MODEL=gemini-2.5-flash

# Optional: AI requests allowed per IP per minute (default 12).
RATE_LIMIT_MAX=
